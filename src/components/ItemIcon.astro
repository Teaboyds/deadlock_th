---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  /** File name in public/items/, which is git-ignored, so it may be missing. */
  image: string;
  size?: 'sm' | 'lg';
  /** Set when the item's name is already written beside the icon. */
  decorative?: boolean;
}

const { name, image, size = 'lg', decorative = false } = Astro.props;
const box = size === 'sm' ? 'size-8 text-xs' : 'size-14 text-lg';
const px = size === 'sm' ? 32 : 56;
const hasImage = existsSync(join(process.cwd(), 'public', 'items', image));
const initials = name
  .split(/[\s-]+/)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{
  hasImage ? (
    <img data-item-icon src={`/items/${image}`} alt={decorative ? '' : name} width={px} height={px} class:list={[box, 'flex-none border border-base-300 bg-base-100 p-0.5']} />
  ) : (
    <div
      data-item-icon
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : name}
      aria-hidden={decorative ? 'true' : undefined}
      class:list={[box, 'font-display grid flex-none place-items-center border border-base-300 bg-base-100 text-secondary']}
    >
      {initials}
    </div>
  )
}
