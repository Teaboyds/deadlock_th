---
interface Props {
  /** In-page shortcuts, in the order the sections appear. */
  items: { href: string; label: string; /** A sub-entry, indented under the one before it. */ nested?: boolean }[];
}

const { items } = Astro.props;
---

<nav aria-label="สารบัญ" class="page-contents mb-8 wide:mt-10 wide:mb-0">
  <p class="mb-2 hidden text-xs tracking-[0.12em] text-secondary wide:block" aria-hidden="true">สารบัญ</p>
  <ul
    class="flex flex-wrap justify-center gap-2 wide:flex-col wide:flex-nowrap wide:justify-start wide:gap-0 wide:border-l wide:border-base-300"
  >
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              { 'wide:pl-7': item.nested },
              'inline-block border border-base-300 px-3 py-1 text-sm hover:bg-base-200 wide:-ml-px wide:block wide:border-0 wide:border-l-2 wide:border-transparent wide:px-3.5 wide:py-1.5 wide:text-secondary wide:hover:bg-transparent wide:hover:text-base-content wide:aria-[current=location]:border-secondary wide:aria-[current=location]:text-base-content',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Highlight the section being read, and disable links whose section a search or filter has hidden.
  const READ_LINE_PX = 140;

  for (const nav of document.querySelectorAll<HTMLElement>('.page-contents')) {
    const entries = [...nav.querySelectorAll<HTMLAnchorElement>('a')]
      .map((link) => ({ link, target: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((e): e is { link: HTMLAnchorElement; target: HTMLElement } => e.target !== null);

    const isHidden = (el: HTMLElement) => el.closest('[hidden]') !== null;

    const markCurrent = () => {
      let current = entries.find((e) => !isHidden(e.target));
      for (const e of entries) {
        if (!isHidden(e.target) && e.target.getBoundingClientRect().top <= READ_LINE_PX) current = e;
      }
      for (const e of entries) {
        if (e === current) e.link.setAttribute('aria-current', 'location');
        else e.link.removeAttribute('aria-current');
      }
    };

    const markHidden = () => {
      for (const { link, target } of entries) {
        if (isHidden(target)) {
          link.setAttribute('aria-disabled', 'true');
          link.tabIndex = -1;
        } else {
          link.removeAttribute('aria-disabled');
          link.removeAttribute('tabindex');
        }
      }
      markCurrent();
    };

    let frame = 0;
    window.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(markCurrent);
      },
      { passive: true },
    );
    new MutationObserver(markHidden).observe(document.body, {
      subtree: true,
      attributes: true,
      attributeFilter: ['hidden'],
    });
    nav.addEventListener('click', (event) => {
      const link = (event.target as Element).closest('a');
      if (link?.getAttribute('aria-disabled') === 'true') event.preventDefault();
    });
    markHidden();
  }
</script>
