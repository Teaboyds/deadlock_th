---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categorySlug, itemCategories } from '../../data/item-categories';

const items = await getCollection('items');
const categories = itemCategories.map((category) => ({
  category,
  count: items.filter((i) => i.data.category === category).length,
}));
---

<SiteLayout title="Items" currentTab="items">
  <h1 class="deco-title mb-6 text-center text-4xl sm:text-5xl">Items</h1>
  <p class="mx-auto mb-10 max-w-2xl text-center">
    Item ที่ซื้อจากร้านค้าระหว่างแมตช์ แบ่งเป็น 3 หมวด ค่าทั้งหมดเป็นของแมตช์ปกติ 6v6
  </p>

  <section aria-label="หมวด Item">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        categories.map(({ category, count }) => (
          <li>
            <a
              href={`/items/${categorySlug(category)}`}
              class:list={['card deco-card h-full bg-base-200 transition-colors hover:bg-base-300', { 'opacity-80': count === 0 }]}
            >
              <div class="card-body">
                <h2 class="card-title text-2xl">{category}</h2>
                {count > 0 ? (
                  <p>{count} Item</p>
                ) : (
                  <div class="card-actions">
                    <span class="badge badge-outline">Coming soon</span>
                  </div>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</SiteLayout>
